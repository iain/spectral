  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#5E574A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
